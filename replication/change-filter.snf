# https://dev.mysql.com/doc/refman/8.4/en/change-replication-filter.html

CHANGE REPLICATION FILTER filter_option [, ...]
    [ FOR CHANNEL 'channel' ]

# ONEOFIS filter_option
REPLICATE_DO_DB = ( [ database [, ...] ] )
REPLICATE_IGNORE_DB = ( [ database [, ...] ] )
REPLICATE_DO_TABLE = ( [ qualified_table [, ...] ] )
REPLICATE_IGNORE_TABLE = ( [ qualified_table [, ...] ] )
REPLICATE_WILD_DO_TABLE = ( [ table_pattern_value [, ...] ] )
REPLICATE_WILD_IGNORE_TABLE = ( [ table_pattern_value [, ...] ] )
REPLICATE_REWRITE_DB = ( [ database_pair [, ...] ] )

# WHERE qualified_table
database . table

# WHERE table_pattern_value
'database_table_pattern'

# WHERE database_pair
( from_database , to_database )
