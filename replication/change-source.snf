# https://dev.mysql.com/doc/refman/8.4/en/change-replication-source-to.html

# CASE SOURCE_HOST
CHANGE REPLICATION SOURCE TO SOURCE_HOST = 'host'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_PORT
CHANGE REPLICATION SOURCE TO SOURCE_PORT = port
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_USER
CHANGE REPLICATION SOURCE TO SOURCE_USER = 'user'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_PASSWORD
CHANGE REPLICATION SOURCE TO SOURCE_PASSWORD = 'password'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_BIND
CHANGE REPLICATION SOURCE TO SOURCE_BIND = 'interface'
    [ FOR CHANNEL 'channel' ]

# CASE PRIVILEGE_CHECKS_USER
CHANGE REPLICATION SOURCE TO PRIVILEGE_CHECKS_USER = { NULL | 'account' }
    [ FOR CHANNEL 'channel' ]

# CASE REQUIRE_ROW_FORMAT
CHANGE REPLICATION SOURCE TO REQUIRE_ROW_FORMAT = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]

# CASE REQUIRE_TABLE_PRIMARY_KEY_CHECK
CHANGE REPLICATION SOURCE TO
    REQUIRE_TABLE_PRIMARY_KEY_CHECK = { STREAM | ON | OFF | GENERATE }
    [ FOR CHANNEL 'channel' ]

# CASE ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS
CHANGE REPLICATION SOURCE TO
    ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS = { OFF | LOCAL | 'uuid' }
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_LOG_FILE
CHANGE REPLICATION SOURCE TO SOURCE_LOG_FILE = 'source_log'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_LOG_POS
CHANGE REPLICATION SOURCE TO SOURCE_LOG_POS = source_position
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_AUTO_POSITION
CHANGE REPLICATION SOURCE TO SOURCE_AUTO_POSITION = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]

# CASE RELAY_LOG_FILE
CHANGE REPLICATION SOURCE TO RELAY_LOG_FILE = 'relay_log'
    [ FOR CHANNEL 'channel' ]

# CASE RELAY_LOG_POS
CHANGE REPLICATION SOURCE TO RELAY_LOG_POS = relay_position
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_HEARTBEAT_PERIOD
CHANGE REPLICATION SOURCE TO SOURCE_HEARTBEAT_PERIOD = interval_expression
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_CONNECT_RETRY
CHANGE REPLICATION SOURCE TO SOURCE_CONNECT_RETRY = interval_expression
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_RETRY_COUNT
CHANGE REPLICATION SOURCE TO SOURCE_RETRY_COUNT = count
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_CONNECTION_AUTO_FAILOVER
CHANGE REPLICATION SOURCE TO SOURCE_CONNECTION_AUTO_FAILOVER = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_DELAY
CHANGE REPLICATION SOURCE TO SOURCE_DELAY = interval_expression
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_COMPRESSION_ALGORITHMS
CHANGE REPLICATION SOURCE TO SOURCE_COMPRESSION_ALGORITHMS = 'algorithms'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_ZSTD_COMPRESSION_LEVEL
CHANGE REPLICATION SOURCE TO SOURCE_ZSTD_COMPRESSION_LEVEL = level
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL
CHANGE REPLICATION SOURCE TO SOURCE_SSL = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_CA
CHANGE REPLICATION SOURCE TO SOURCE_SSL_CA = 'ca_file'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_CAPATH
CHANGE REPLICATION SOURCE TO SOURCE_SSL_CAPATH = 'ca_directory'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_CERT
CHANGE REPLICATION SOURCE TO SOURCE_SSL_CERT = 'certificate_file'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_CRL
CHANGE REPLICATION SOURCE TO SOURCE_SSL_CRL = 'crl_file'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_CRLPATH
CHANGE REPLICATION SOURCE TO SOURCE_SSL_CRLPATH = 'crl_directory'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_KEY
CHANGE REPLICATION SOURCE TO SOURCE_SSL_KEY = 'key_file'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_CIPHER
CHANGE REPLICATION SOURCE TO SOURCE_SSL_CIPHER = 'ciphers'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_SSL_VERIFY_SERVER_CERT
CHANGE REPLICATION SOURCE TO SOURCE_SSL_VERIFY_SERVER_CERT = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_TLS_VERSION
CHANGE REPLICATION SOURCE TO SOURCE_TLS_VERSION = 'protocols'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_TLS_CIPHERSUITES
CHANGE REPLICATION SOURCE TO SOURCE_TLS_CIPHERSUITES = 'ciphersuites'
    [ FOR CHANNEL 'channel' ]

# CASE SOURCE_PUBLIC_KEY_PATH
CHANGE REPLICATION SOURCE TO SOURCE_PUBLIC_KEY_PATH = 'public_key_file'
    [ FOR CHANNEL 'channel' ]

# CASE GET_SOURCE_PUBLIC_KEY
CHANGE REPLICATION SOURCE TO GET_SOURCE_PUBLIC_KEY = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]

# CASE NETWORK_NAMESPACE
CHANGE REPLICATION SOURCE TO NETWORK_NAMESPACE = 'namespace'
    [ FOR CHANNEL 'channel' ]

# CASE IGNORE_SERVER_IDS
CHANGE REPLICATION SOURCE TO IGNORE_SERVER_IDS = ( server_id [, ...] )
    [ FOR CHANNEL 'channel' ]

# CASE GTID_ONLY
CHANGE REPLICATION SOURCE TO GTID_ONLY = { 0 | 1 }
    [ FOR CHANNEL 'channel' ]
