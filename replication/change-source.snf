# https://dev.mysql.com/doc/refman/8.4/en/change-replication-source-to.html

CHANGE REPLICATION SOURCE TO source_option [, ...]
    [ FOR CHANNEL 'channel' ]

# ONEOFIS source_option
SOURCE_HOST = 'host'
SOURCE_PORT = port
SOURCE_USER = 'user'
SOURCE_PASSWORD = 'password'
SOURCE_BIND = 'interface'
PRIVILEGE_CHECKS_USER = { NULL | account }
REQUIRE_ROW_FORMAT = { 0 | 1 }
REQUIRE_TABLE_PRIMARY_KEY_CHECK = { STREAM | ON | OFF | GENERATE }
ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS = { OFF | LOCAL | 'uuid' }
SOURCE_LOG_FILE = 'source_log'
SOURCE_LOG_POS = source_position
SOURCE_AUTO_POSITION = { 0 | 1 }
RELAY_LOG_FILE = 'relay_log'
RELAY_LOG_POS = relay_position
SOURCE_HEARTBEAT_PERIOD = interval_expression
SOURCE_CONNECT_RETRY = interval_expression
SOURCE_RETRY_COUNT = count
SOURCE_CONNECTION_AUTO_FAILOVER = { 0 | 1 }
SOURCE_DELAY = interval_expression
SOURCE_COMPRESSION_ALGORITHMS = 'algorithms'
SOURCE_ZSTD_COMPRESSION_LEVEL = level
SOURCE_SSL = { 0 | 1 }
SOURCE_SSL_CA = 'ca_file'
SOURCE_SSL_CAPATH = 'ca_directory'
SOURCE_SSL_CERT = 'certificate_file'
SOURCE_SSL_CRL = 'crl_file'
SOURCE_SSL_CRLPATH = 'crl_directory'
SOURCE_SSL_KEY = 'key_file'
SOURCE_SSL_CIPHER = 'ciphers'
SOURCE_SSL_VERIFY_SERVER_CERT = { 0 | 1 }
SOURCE_TLS_VERSION = 'protocols'
SOURCE_TLS_CIPHERSUITES = 'ciphersuites'
SOURCE_PUBLIC_KEY_PATH = 'public_key_file'
GET_SOURCE_PUBLIC_KEY = { 0 | 1 }
NETWORK_NAMESPACE = 'namespace'
IGNORE_SERVER_IDS = ( server_id [, ...] )
GTID_ONLY = { 0 | 1 }
