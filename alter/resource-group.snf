# https://dev.mysql.com/doc/refman/8.4/en/alter-resource-group.html

# CASE OPTIONS
ALTER RESOURCE GROUP resource_group
    [ VCPU [=] vcpu [, ...] ]
    [ THREAD_PRIORITY [=] priority ]

# CASE ENABLE
ALTER RESOURCE GROUP resource_group ENABLE

# CASE DISABLE
ALTER RESOURCE GROUP resource_group DISABLE [ FORCE ]

# ONEOFIS vcpu
number
from_number - to_number
