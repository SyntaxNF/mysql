# https://dev.mysql.com/doc/refman/8.4/en/alter-event.html

# CASE OPTIONS
ALTER [ DEFINER = user ] EVENT name
    [ ON SCHEDULE schedule_definition ]
    [ ON COMPLETION [ NOT ] PRESERVE ]
    [ ENABLE | DISABLE | DISABLE ON { REPLICA | SLAVE } ]
    [ COMMENT 'comment' ]

# CASE RENAME
ALTER [ DEFINER = user ] EVENT name RENAME TO new_name

# CASE BODY
ALTER [ DEFINER = user ] EVENT name DO event_statement

# ONEOFIS schedule_definition
AT datetime_expression [ + INTERVAL interval_expression ] [...]
EVERY interval_expression [ STARTS datetime_expression [ + INTERVAL interval_expression ] [...] ] [ ENDS datetime_expression [ + INTERVAL interval_expression ] [...] ]

# WHERE interval_expression
quantity { YEAR | QUARTER | MONTH | DAY | HOUR | MINUTE | WEEK | SECOND | YEAR_MONTH | DAY_HOUR | DAY_MINUTE | DAY_SECOND | HOUR_MINUTE | HOUR_SECOND | MINUTE_SECOND }

# STATEMENT event_statement
sql_statement
compound_statement
