# https://dev.mysql.com/doc/refman/8.4/en/alter-event.html

# CASE OPTIONS
ALTER [ DEFINER = user ] EVENT event
    [ ON SCHEDULE schedule ]
    [ ON COMPLETION [ NOT ] PRESERVE ]
    [ ENABLE | DISABLE | DISABLE ON { REPLICA | SLAVE } ]
    [ COMMENT 'comment' ]

# CASE RENAME
ALTER [ DEFINER = user ] EVENT event RENAME TO new_event

# CASE BODY
ALTER [ DEFINER = user ] EVENT event DO event_body

# ONEOFIS schedule
AT timestamp [ + INTERVAL interval ] [...]
EVERY interval [ STARTS timestamp [ + INTERVAL interval ] [...] ] [ ENDS timestamp [ + INTERVAL interval ] [...] ]

# WHERE interval
quantity { YEAR | QUARTER | MONTH | DAY | HOUR | MINUTE | WEEK | SECOND | YEAR_MONTH | DAY_HOUR | DAY_MINUTE | DAY_SECOND | HOUR_MINUTE | HOUR_SECOND | MINUTE_SECOND }

# STATEMENT event_body
sql_statement
compound_statement
