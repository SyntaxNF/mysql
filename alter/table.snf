# https://dev.mysql.com/doc/refman/8.4/en/alter-table.html

# CASE OPTIONS
ALTER TABLE name action [, ...]

# CASE RENAME_COLUMN
ALTER TABLE name RENAME COLUMN colname TO new_colname

# CASE RENAME_INDEX
ALTER TABLE name RENAME { INDEX | KEY } index TO new_index

# CASE RENAME
ALTER TABLE name RENAME [ TO | AS ] new_name

# CASE ADD_PARTITION
ALTER TABLE name ADD PARTITION ( partition_definition [, ...] )

# CASE DROP_PARTITION
ALTER TABLE name DROP PARTITION partition [, ...]

# CASE DISCARD_PARTITION
ALTER TABLE name DISCARD PARTITION { partition [, ...] | ALL } TABLESPACE

# CASE IMPORT_PARTITION
ALTER TABLE name IMPORT PARTITION { partition [, ...] | ALL } TABLESPACE

# CASE TRUNCATE_PARTITION
ALTER TABLE name TRUNCATE PARTITION { partition [, ...] | ALL }

# CASE COALESCE_PARTITION
ALTER TABLE name COALESCE PARTITION number

# CASE REORGANIZE_PARTITION
ALTER TABLE name
    REORGANIZE PARTITION partition [, ...]
    INTO ( partition_definition [, ...] )

# CASE EXCHANGE_PARTITION
ALTER TABLE name
    EXCHANGE PARTITION partition WITH TABLE table
    [ { WITH | WITHOUT } VALIDATION ]

# CASE MAINTAIN_PARTITION
ALTER TABLE name
    { ANALYZE | CHECK | OPTIMIZE | REBUILD | REPAIR }
    PARTITION { partition [, ...] | ALL }

# CASE REMOVE_PARTITIONING
ALTER TABLE name REMOVE PARTITIONING

# PARTOFIS action
table_option

ADD [ COLUMN ] colname column_definition [ FIRST | AFTER colname ]

ADD [ COLUMN ] ( colname column_definition [, ...] )

ADD { INDEX | KEY } [ index ] [ USING { BTREE | HASH } ]
( index_column_expression [, ...] ) index_options

ADD { FULLTEXT | SPATIAL } [ INDEX | KEY ] [ index ]
( index_column_expression [, ...] ) index_options

ADD [ CONSTRAINT [ constraint ] ] PRIMARY KEY
[ USING { BTREE | HASH } ] ( index_column_expression [, ...] ) index_options

ADD [ CONSTRAINT [ constraint ] ] UNIQUE [ INDEX | KEY ] [ index ]
[ USING { BTREE | HASH } ] ( index_column_expression [, ...] ) index_options

ADD [ CONSTRAINT [ constraint ] ] FOREIGN KEY [ index ]
( colname [, ...] ) references

ADD [ CONSTRAINT [ constraint ] ] CHECK ( boolean_expression ) [ [ NOT ] ENFORCED ]

DROP { CHECK | CONSTRAINT } constraint

ALTER { CHECK | CONSTRAINT } constraint [ NOT ] ENFORCED

ALGORITHM [=] { DEFAULT | INSTANT | INPLACE | COPY }

ALTER [ COLUMN ] colname { SET DEFAULT { value | ( value_expression ) } | SET { VISIBLE | INVISIBLE } | DROP DEFAULT }

ALTER INDEX index { VISIBLE | INVISIBLE }

CHANGE [ COLUMN ] colname new_colname column_definition [ FIRST | AFTER colname ]

[ DEFAULT ] CHARACTER SET [=] charset [ COLLATE [=] collate ]

CONVERT TO CHARACTER SET charset [ COLLATE collate ]

{ DISABLE | ENABLE } KEYS

{ DISCARD | IMPORT } TABLESPACE

DROP [ COLUMN ] colname

DROP { INDEX | KEY } index

DROP PRIMARY KEY

DROP FOREIGN KEY foreign_key

FORCE

LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE }

MODIFY [ COLUMN ] colname column_definition [ FIRST | AFTER colname ]

ORDER BY colname [, ...]

{ WITHOUT | WITH } VALIDATION

# PARTOFIS column_definition
type [ NOT NULL | NULL ] [ DEFAULT { value | ( value_expression ) } ]
[ VISIBLE | INVISIBLE ] [ AUTO_INCREMENT ] [ UNIQUE [ KEY ] ] [ [ PRIMARY ] KEY ]
[ COMMENT 'comment' ] [ COLLATE collate ]
[ COLUMN_FORMAT { FIXED | DYNAMIC | DEFAULT } ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ] [ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]
[ STORAGE { DISK | MEMORY } ] [ references ] [ check_constraint_definition ]

type [ COLLATE collate ] [ GENERATED ALWAYS ] AS ( col_expression )
[ VIRTUAL | STORED ] [ NOT NULL | NULL ] [ VISIBLE | INVISIBLE ]
[ UNIQUE [ KEY ] ] [ [ PRIMARY ] KEY ] [ COMMENT 'comment' ]
[ references ] [ check_constraint_definition ]

# WHERE index_column_expression
{ colname [ ( length ) ] | ( col_expression ) } [ ASC | DESC ]

# WHERE references
REFERENCES table ( colname [, ...] )
    [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
    [ ON DELETE on_delete_action ]
    [ ON UPDATE on_update_action ]

# WHERE on_delete_action, on_update_action
{ RESTRICT | CASCADE | SET NULL | NO ACTION | SET DEFAULT }

# WHERE check_constraint_definition
[ CONSTRAINT [ constraint ] ] CHECK ( boolean_expression ) [ [ NOT ] ENFORCED ]

# WHERE index_options
[ KEY_BLOCK_SIZE [=] value ]
[ WITH PARSER parser ]
[ COMMENT 'comment' ]
[ VISIBLE | INVISIBLE ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ]
[ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]

# ONEOFIS table_option
AUTOEXTEND_SIZE [=] value
AUTO_INCREMENT [=] value
AVG_ROW_LENGTH [=] value
[ DEFAULT ] CHARACTER SET [=] charset
CHECKSUM [=] { 0 | 1 }
[ DEFAULT ] COLLATE [=] collate
COMMENT [=] 'comment'
COMPRESSION [=] { 'ZLIB' | 'LZ4' | 'NONE' }
CONNECTION [=] 'connection'
{ DATA | INDEX } DIRECTORY [=] 'directory'
DELAY_KEY_WRITE [=] { 0 | 1 }
ENCRYPTION [=] { 'Y' | 'N' }
ENGINE [=] engine
ENGINE_ATTRIBUTE [=] 'engine_attribute'
INSERT_METHOD [=] { NO | FIRST | LAST }
KEY_BLOCK_SIZE [=] value
MAX_ROWS [=] value
MIN_ROWS [=] value
PACK_KEYS [=] { 0 | 1 | DEFAULT }
PASSWORD [=] 'password'
ROW_FORMAT [=] { DEFAULT | DYNAMIC | FIXED | COMPRESSED | REDUNDANT | COMPACT }
SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute'
STATS_AUTO_RECALC [=] { DEFAULT | 0 | 1 }
STATS_PERSISTENT [=] { DEFAULT | 0 | 1 }
STATS_SAMPLE_PAGES [=] value
TABLESPACE tablespace [ STORAGE { DISK | MEMORY } ]
UNION [=] ( table [, ...] )

# WHERE partition_definition
PARTITION partition
    [ VALUES { LESS THAN { ( value [, ...] ) | MAXVALUE } | IN ( value [, ...] ) } ]
    [ [ STORAGE ] ENGINE [=] engine ]
    [ COMMENT [=] 'comment' ]
    [ DATA DIRECTORY [=] 'directory' ]
    [ INDEX DIRECTORY [=] 'directory' ]
    [ MAX_ROWS [=] value ] [ MIN_ROWS [=] value ]
    [ TABLESPACE [=] tablespace ]
