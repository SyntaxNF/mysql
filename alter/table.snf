# https://dev.mysql.com/doc/refman/8.4/en/alter-table.html

# CASE OPTIONS
ALTER TABLE name
    alter_action [, ...]
    [ partition_options | REMOVE PARTITIONING ]

# CASE ADD_COLUMN
ALTER TABLE name ADD [ COLUMN ] colname column_definition
    [ FIRST | AFTER colname ]

# CASE DROP_COLUMN
ALTER TABLE name DROP [ COLUMN ] colname

# CASE MODIFY_COLUMN
ALTER TABLE name MODIFY [ COLUMN ] colname column_definition
    [ FIRST | AFTER colname ]

# CASE CHANGE_COLUMN
ALTER TABLE name CHANGE [ COLUMN ] colname new_colname column_definition
    [ FIRST | AFTER colname ]

# CASE SET_COLUMN_DEFAULT
ALTER TABLE name ALTER [ COLUMN ] colname
    SET DEFAULT { value | ( value_expression ) }

# CASE DROP_COLUMN_DEFAULT
ALTER TABLE name ALTER [ COLUMN ] colname DROP DEFAULT

# CASE RENAME_COLUMN
ALTER TABLE name
    RENAME COLUMN colname TO new_colname

# CASE RENAME_INDEX
ALTER TABLE name
    RENAME { INDEX | KEY } index TO new_index

# CASE RENAME
ALTER TABLE name
    RENAME [ TO | AS ] new_name

# CASE PARTITION_BY
ALTER TABLE name
    partition_options

# CASE ADD_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    ADD PARTITION (
        partition_definition [, ...]
    )

# CASE ADD_HASH_KEY_PARTITIONS
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    ADD PARTITION PARTITIONS number

# CASE DROP_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    DROP PARTITION partition [, ...]

# CASE DISCARD_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] DEFAULT , ]
    [ LOCK [=] DEFAULT , ]
    DISCARD PARTITION { partition [, ...] | ALL }
    TABLESPACE

# CASE IMPORT_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] DEFAULT , ]
    [ LOCK [=] DEFAULT , ]
    IMPORT PARTITION { partition [, ...] | ALL }
    TABLESPACE

# CASE TRUNCATE_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    TRUNCATE PARTITION { partition [, ...] | ALL }

# CASE COALESCE_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    COALESCE PARTITION number

# CASE REORGANIZE_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    REORGANIZE PARTITION partition [, ...]
    INTO (
        partition_definition [, ...]
    )

# CASE EXCHANGE_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    EXCHANGE PARTITION partition WITH TABLE table
    [ { WITH | WITHOUT } VALIDATION ]

# CASE MAINTAIN_PARTITION
ALTER TABLE name
    [ ALGORITHM [=] { DEFAULT | INPLACE | COPY } , ]
    [ LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE } , ]
    { ANALYZE | CHECK | OPTIMIZE | REBUILD | REPAIR }
    PARTITION { partition [, ...] | ALL }

# CASE REMOVE_PARTITIONING
ALTER TABLE name REMOVE PARTITIONING

# PARTOFIS alter_action
AUTOEXTEND_SIZE [=] value

AUTO_INCREMENT [=] value

AVG_ROW_LENGTH [=] value

[ DEFAULT ] CHARACTER SET [=] charset

CHECKSUM [=] { 0 | 1 }

[ DEFAULT ] COLLATE [=] collate

COMMENT [=] 'comment'

COMPRESSION [=] { 'ZLIB' | 'LZ4' | 'NONE' }

CONNECTION [=] 'connection'

{ DATA | INDEX } DIRECTORY [=] 'directory'

DELAY_KEY_WRITE [=] { 0 | 1 }

ENCRYPTION [=] { 'Y' | 'N' }

ENGINE [=] engine

ENGINE_ATTRIBUTE [=] 'engine_attribute'

INSERT_METHOD [=] { NO | FIRST | LAST }

KEY_BLOCK_SIZE [=] value

MAX_ROWS [=] value

MIN_ROWS [=] value

PACK_KEYS [=] { 0 | 1 | DEFAULT }

PASSWORD [=] 'password'

ROW_FORMAT [=] { DEFAULT | DYNAMIC | FIXED | COMPRESSED | REDUNDANT | COMPACT }

SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute'

STATS_AUTO_RECALC [=] { DEFAULT | 0 | 1 }

STATS_PERSISTENT [=] { DEFAULT | 0 | 1 }

STATS_SAMPLE_PAGES [=] value

TABLESPACE tablespace [ STORAGE { DISK | MEMORY } ]

UNION [=] ( table [, ...] )

ADD [ COLUMN ] colname
    column_definition
    [ FIRST | AFTER colname ]

ADD [ COLUMN ] (
    { colname column_definition } [, ...]
)

ADD { INDEX | KEY } [ index ]
    [ USING { BTREE | HASH } ]
    ( index_column_expression [, ...] )
    index_options

ADD { FULLTEXT | SPATIAL } [ INDEX | KEY ] [ index ]
    ( index_column_expression [, ...] )
    index_options

ADD [ CONSTRAINT [ constraint ] ]
    PRIMARY KEY
    [ USING { BTREE | HASH } ]
    ( index_column_expression [, ...] )
    index_options

ADD [ CONSTRAINT [ constraint ] ]
    UNIQUE [ INDEX | KEY ] [ index ]
    [ USING { BTREE | HASH } ]
    ( index_column_expression [, ...] )
    index_options

ADD [ CONSTRAINT [ constraint ] ]
    FOREIGN KEY [ index ]
    ( colname [, ...] )
    reference_definition

ADD [ CONSTRAINT [ constraint ] ]
    CHECK ( boolean_expression )
    [ [ NOT ] ENFORCED ]

DROP { CHECK | CONSTRAINT } constraint

ALTER { CHECK | CONSTRAINT } constraint
    [ NOT ] ENFORCED

ALGORITHM [=] { DEFAULT | INSTANT | INPLACE | COPY }

ALTER [ COLUMN ] colname
    { SET DEFAULT { value | ( value_expression ) } | SET { VISIBLE | INVISIBLE } | DROP DEFAULT }

ALTER INDEX index
    { VISIBLE | INVISIBLE }

CHANGE [ COLUMN ] colname new_colname
    column_definition
    [ FIRST | AFTER colname ]

[ DEFAULT ] CHARACTER SET [=] charset
    [ COLLATE [=] collate ]

CONVERT TO CHARACTER SET charset
    [ COLLATE collate ]

{ DISABLE | ENABLE } KEYS

{ DISCARD | IMPORT } TABLESPACE

DROP [ COLUMN ] colname

DROP { INDEX | KEY } index

RENAME COLUMN colname TO new_colname

RENAME { INDEX | KEY } index TO new_index

DROP PRIMARY KEY

DROP FOREIGN KEY foreign_key

FORCE

LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE }

MODIFY [ COLUMN ] colname
    column_definition
    [ FIRST | AFTER colname ]

ORDER BY colname [, ...]

{ WITHOUT | WITH } VALIDATION

# PARTOFIS column_definition
type
[ NOT NULL | NULL ]
[ DEFAULT { value | CURRENT_TIMESTAMP [ ( fractional_precision ) ] | ( value_expression ) } ]
[ ON UPDATE CURRENT_TIMESTAMP [ ( fractional_precision ) ] ]
[ VISIBLE | INVISIBLE ]
[ AUTO_INCREMENT ]
[ UNIQUE [ KEY ] ]
[ [ PRIMARY ] KEY ]
[ COMMENT 'comment' ]
[ COLLATE collate ]
[ SRID srid ]
[ COLUMN_FORMAT { FIXED | DYNAMIC | DEFAULT } ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ]
[ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]
[ STORAGE { DISK | MEMORY } ]
[ reference_definition ]
[ check_constraint_definition ]

type
[ COLLATE collate ]
[ GENERATED ALWAYS ] AS ( col_expression )
[ VIRTUAL | STORED ]
[ NOT NULL | NULL ]
[ VISIBLE | INVISIBLE ]
[ UNIQUE [ KEY ] ]
[ [ PRIMARY ] KEY ]
[ COMMENT 'comment' ]
[ reference_definition ]
[ check_constraint_definition ]

# WHERE index_column_expression
{ colname [ ( length ) ] | ( col_expression ) } [ ASC | DESC ]

# WHERE reference_definition
REFERENCES table ( colname [, ...] )
    [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
    [ ON DELETE on_delete_action ]
    [ ON UPDATE on_update_action ]

# WHERE on_delete_action, on_update_action
{ RESTRICT | CASCADE | SET NULL | NO ACTION | SET DEFAULT }

# WHERE check_constraint_definition
[ CONSTRAINT [ constraint ] ]
    CHECK ( boolean_expression )
    [ [ NOT ] ENFORCED ]

# WHERE index_options
[ KEY_BLOCK_SIZE [=] value ]
[ WITH PARSER parser ]
[ COMMENT 'comment' ]
[ VISIBLE | INVISIBLE ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ]
[ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]

# WHERE partition_options
PARTITION BY partition_method
    [ PARTITIONS number ]
    [ SUBPARTITION BY subpartition_method [ SUBPARTITIONS number ] ]
    [ ( partition_definition [, ...] ) ]

# ONEOFIS partition_method
[ LINEAR ] HASH ( col_expression )
[ LINEAR ] KEY [ ALGORITHM = { 1 | 2 } ] ( [ colname [, ...] ] )
RANGE { ( col_expression ) | COLUMNS ( colname [, ...] ) }
LIST { ( col_expression ) | COLUMNS ( colname [, ...] ) }

# ONEOFIS subpartition_method
[ LINEAR ] HASH ( col_expression )
[ LINEAR ] KEY [ ALGORITHM = { 1 | 2 } ] ( colname [, ...] )

# WHERE partition_definition
PARTITION partition
    [ VALUES { LESS THAN { ( partition_bound_value [, ...] ) | MAXVALUE } | IN ( partition_list_value [, ...] ) } ]
    [ [ STORAGE ] ENGINE [=] engine ]
    [ COMMENT [=] 'comment' ]
    [ DATA DIRECTORY [=] 'directory' ]
    [ INDEX DIRECTORY [=] 'directory' ]
    [ MAX_ROWS [=] value ] [ MIN_ROWS [=] value ]
    [ TABLESPACE [=] tablespace ]
    [ ( subpartition_definition [, ...] ) ]

# WHERE subpartition_definition
SUBPARTITION subpartition
    [ [ STORAGE ] ENGINE [=] engine ]
    [ COMMENT [=] 'comment' ]
    [ DATA DIRECTORY [=] 'directory' ]
    [ INDEX DIRECTORY [=] 'directory' ]
    [ MAX_ROWS [=] value ] [ MIN_ROWS [=] value ]
    [ TABLESPACE [=] tablespace ]

# WHERE partition_bound_value
{ value_expression | MAXVALUE }

# WHERE partition_list_value
{ value_expression | ( value_expression [, ...] ) }
