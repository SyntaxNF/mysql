# https://dev.mysql.com/doc/refman/8.4/en/alter-user.html

# CASE CURRENT_PASSWORD
ALTER USER [ IF EXISTS ] USER ( )
    IDENTIFIED BY 'auth_string'
    [ REPLACE 'current_auth_string' ]
    [ RETAIN CURRENT PASSWORD ]

# CASE CURRENT_DISCARD_PASSWORD
ALTER USER [ IF EXISTS ] USER ( ) DISCARD OLD PASSWORD

# CASE OPTIONS
ALTER USER [ IF EXISTS ]
    account_definition [, ...]
    [ REQUIRE { NONE | tls_requirements } ]
    [ WITH resource_options ]
    [ PASSWORD EXPIRE [ DEFAULT | NEVER | INTERVAL number DAY ] ]
    [ PASSWORD HISTORY { DEFAULT | number } ]
    [ PASSWORD REUSE INTERVAL { DEFAULT | number DAY } ]
    [ PASSWORD REQUIRE CURRENT [ DEFAULT | OPTIONAL ] ]
    [ FAILED_LOGIN_ATTEMPTS number ]
    [ PASSWORD_LOCK_TIME { number | UNBOUNDED } ]
    [ ACCOUNT LOCK | ACCOUNT UNLOCK ]
    [ COMMENT 'comment' | ATTRIBUTE 'json' ]

# CASE DEFAULT_ROLE
ALTER USER [ IF EXISTS ] account DEFAULT ROLE
    { NONE | ALL | role [, ...] }

# CASE REGISTRATION
ALTER USER [ IF EXISTS ] { account | USER ( ) }
    factor registration_option

# PARTOFIS registration_option
INITIATE REGISTRATION

FINISH REGISTRATION SET CHALLENGE_RESPONSE AS 'auth_string'

UNREGISTER

# WHERE account_definition
account [ auth_option ]

# PARTOFIS auth_option
IDENTIFIED BY { 'auth_string' | RANDOM PASSWORD }
    [ REPLACE 'current_auth_string' ]
    [ RETAIN CURRENT PASSWORD ]

IDENTIFIED WITH auth_plugin

IDENTIFIED WITH auth_plugin BY { 'auth_string' | RANDOM PASSWORD }
    [ REPLACE 'current_auth_string' ]
    [ RETAIN CURRENT PASSWORD ]

IDENTIFIED WITH auth_plugin AS 'auth_string'

DISCARD OLD PASSWORD

ADD factor factor_auth_option [ ADD factor factor_auth_option ]

MODIFY factor factor_auth_option [ MODIFY factor factor_auth_option ]

DROP factor [ DROP factor ]

# PARTOFIS factor_auth_option
IDENTIFIED BY { 'auth_string' | RANDOM PASSWORD }

IDENTIFIED WITH auth_plugin
    { BY { 'auth_string' | RANDOM PASSWORD } | AS 'auth_string' }

# WHERE factor
{ 2 | 3 } FACTOR

# PARTOFIS tls_requirements
SSL

X509

CIPHER 'cipher'
    [ [ AND ] ISSUER 'issuer' ]
    [ [ AND ] SUBJECT 'subject' ]

ISSUER 'issuer'
    [ [ AND ] SUBJECT 'subject' ]

SUBJECT 'subject'

# PARTOFIS resource_options
MAX_QUERIES_PER_HOUR count
    [ MAX_UPDATES_PER_HOUR count ]
    [ MAX_CONNECTIONS_PER_HOUR count ]
    [ MAX_USER_CONNECTIONS count ]

MAX_UPDATES_PER_HOUR count
    [ MAX_CONNECTIONS_PER_HOUR count ]
    [ MAX_USER_CONNECTIONS count ]

MAX_CONNECTIONS_PER_HOUR count
    [ MAX_USER_CONNECTIONS count ]

MAX_USER_CONNECTIONS count
