# https://dev.mysql.com/doc/refman/8.4/en/alter-table.html

# CASE OPTIONS
ALTER TABLE name
    action [, ...]

# PARTOFIS action
ADD [ CONSTRAINT [ constraint ] ]
    PRIMARY KEY
    [ USING { BTREE | HASH } ]
    ( index_column_expression [, ...] )
    index_options

ADD [ CONSTRAINT [ constraint ] ]
    UNIQUE [ INDEX | KEY ] [ index ]
    [ USING { BTREE | HASH } ]
    ( index_column_expression [, ...] )
    index_options

ADD [ CONSTRAINT [ constraint ] ]
    FOREIGN KEY [ index ]
    ( colname [, ...] )
    reference_definition

ADD [ CONSTRAINT [ constraint ] ]
    CHECK ( boolean_expression )
    [ [ NOT ] ENFORCED ]

DROP { CHECK | CONSTRAINT } constraint

ALTER { CHECK | CONSTRAINT } constraint
    [ NOT ] ENFORCED

DROP PRIMARY KEY

DROP FOREIGN KEY foreign_key

ALGORITHM [=] { DEFAULT | INSTANT | INPLACE | COPY }

LOCK [=] { DEFAULT | NONE | SHARED | EXCLUSIVE }

# WHERE index_column_expression
{ colname [ ( length ) ] | ( col_expression ) } [ ASC | DESC ]

# WHERE reference_definition
REFERENCES table ( colname [, ...] )
    [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
    [ ON DELETE on_delete_action ]
    [ ON UPDATE on_update_action ]

# WHERE on_delete_action, on_update_action
{ RESTRICT | CASCADE | SET NULL | NO ACTION | SET DEFAULT }

# WHERE index_options
[ KEY_BLOCK_SIZE [=] value ]
[ WITH PARSER parser ]
[ COMMENT 'comment' ]
[ VISIBLE | INVISIBLE ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ]
[ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]
