# https://dev.mysql.com/doc/refman/8.4/en/xa-statements.html

# CASE START
XA { START | BEGIN } xid [ JOIN | RESUME ]

# CASE END
XA END xid [ SUSPEND [ FOR MIGRATE ] ]

# CASE PREPARE
XA PREPARE xid

# CASE COMMIT
XA COMMIT xid [ ONE PHASE ]

# CASE ROLLBACK
XA ROLLBACK xid

# CASE RECOVER
XA RECOVER [ CONVERT XID ]

# WHERE xid
gtrid [ , bqual [ , format_id ] ]
