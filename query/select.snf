# https://dev.mysql.com/doc/refman/8.4/en/select.html

[ WITH [ RECURSIVE ] with_query_definition [, ...] ]
SELECT [ ALL | DISTINCT | DISTINCTROW ]
    [ HIGH_PRIORITY ] [ STRAIGHT_JOIN ]
    [ SQL_SMALL_RESULT ] [ SQL_BIG_RESULT ] [ SQL_BUFFER_RESULT ]
    [ SQL_NO_CACHE ] [ SQL_CALC_FOUND_ROWS ]
    { * | col_expression [ [ AS ] col_alias ] [, ...] }
    [ FROM from_expression [, ...] ]
    [ WHERE boolean_expression ]
    [ GROUP BY group_by_expression [, ...] [ WITH ROLLUP ] | ROLLUP ( group_by_expression [, ...] ) ]
    [ HAVING boolean_expression ]
    [ WINDOW window AS ( window_expression ) [, ...] ]
    [ ORDER BY order_by_expression [, ...] [ WITH ROLLUP ] ]
    [ LIMIT { [ offset , ] limit | limit OFFSET offset } ]
    [ locking_clause ]
    [ into_option ]

# WHERE with_query_definition
with_name [ ( colname [, ...] ) ] AS ( query_statement )

# PARTOFIS from_expression
table [ PARTITION ( partition [, ...] ) ]
[ [ AS ] table_alias [ ( col_alias [, ...] ) ] ] [ index_hint ]

[ LATERAL ] table_function [ AS ] function_alias [ ( col_alias [, ...] ) ]

( from_expression [, ...] )

from_expression [ INNER ] JOIN from_expression [ join_condition ]

from_expression CROSS JOIN from_expression

from_expression STRAIGHT_JOIN from_expression [ ON boolean_expression ]

from_expression { LEFT | RIGHT } [ OUTER ] JOIN from_expression join_condition

from_expression NATURAL [ INNER | { LEFT | RIGHT } [ OUTER ] ] JOIN from_expression

# ONEOFIS join_condition
ON boolean_expression
USING ( colname [, ...] )

# WHERE index_hint
{ USE | FORCE | IGNORE } { INDEX | KEY }
    [ FOR { JOIN | ORDER BY | GROUP BY } ]
    ( index [, ...] )

# WHERE group_by_expression
{ colname | col_expression | position }

# WHERE order_by_expression
{ colname | col_expression | position } [ ASC | DESC ]

# WHERE window_expression
[ window ]
    [ PARTITION BY col_expression [, ...] ]
    [ ORDER BY order_by_expression [, ...] ]
    [ frame_clause ]

# PARTOFIS frame_clause
{ ROWS | RANGE | GROUPS } frame_bound

{ ROWS | RANGE | GROUPS } BETWEEN frame_bound AND frame_bound

# ONEOFIS frame_bound
UNBOUNDED PRECEDING
value_expression PRECEDING
CURRENT ROW
value_expression FOLLOWING
UNBOUNDED FOLLOWING

# ONEOFIS into_option
INTO OUTFILE 'file' [ CHARACTER SET charset ] export_option
INTO DUMPFILE 'file'
INTO variable [, ...]

# WHERE export_option
[ { FIELDS | COLUMNS }
    [ TERMINATED BY 'string' ]
    [ [ OPTIONALLY ] ENCLOSED BY 'character' ]
    [ ESCAPED BY 'character' ] ]
[ LINES [ STARTING BY 'string' ] [ TERMINATED BY 'string' ] ]

# ONEOFIS locking_clause
FOR { UPDATE | SHARE } [ OF table [, ...] ] [ NOWAIT | SKIP LOCKED ]
LOCK IN SHARE MODE

# STATEMENT query_statement
SELECT
TABLE
VALUES
