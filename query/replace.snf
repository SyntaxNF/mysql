# https://dev.mysql.com/doc/refman/8.4/en/replace.html

# CASE VALUES
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    { { VALUES | VALUE } values_row_definition [, ...] | VALUES row_constructor_definition [, ...] }

# CASE DEFAULT_ROW
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    ( ) VALUES ( )

# CASE SET
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    SET column_assignment [, ...]

# CASE QUERY
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    query_statement

# WHERE row_constructor_definition
ROW ( { value_expression | DEFAULT } [, ...] )

# WHERE values_row_definition
( { value_expression | DEFAULT } [, ...] )

# WHERE column_assignment
colname = { value_expression | DEFAULT }

# STATEMENT query_statement
SELECT
TABLE
