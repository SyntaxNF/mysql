# https://dev.mysql.com/doc/refman/8.4/en/replace.html

# CASE VALUES
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    { { VALUES | VALUE } ( { value_expression | DEFAULT } [, ...] ) [, ...] | VALUES ROW ( { value_expression | DEFAULT } [, ...] ) [, ...] }

# CASE SET
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    SET assignment [, ...]

# CASE QUERY
REPLACE [ LOW_PRIORITY | DELAYED ] [ INTO ] table
    [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    query_statement

# WHERE assignment
colname = value_expression

# STATEMENT query_statement
SELECT
TABLE
