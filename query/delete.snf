# https://dev.mysql.com/doc/refman/8.4/en/delete.html

# CASE SINGLE_TABLE
[ WITH [ RECURSIVE ] with_query_definition [, ...] ]
DELETE [ LOW_PRIORITY ] [ QUICK ] [ IGNORE ]
    FROM table [ [ AS ] table_alias ]
    [ PARTITION ( partition [, ...] ) ]
    [ WHERE boolean_expression ]
    [ ORDER BY order_by_expression [, ...] ]
    [ LIMIT limit ]

# CASE MULTI_TABLE_FROM
[ WITH [ RECURSIVE ] with_query_definition [, ...] ]
DELETE [ LOW_PRIORITY ] [ QUICK ] [ IGNORE ]
    table [ . * ] [, ...]
    FROM from_expression [, ...]
    [ WHERE boolean_expression ]

# CASE MULTI_TABLE_USING
[ WITH [ RECURSIVE ] with_query_definition [, ...] ]
DELETE [ LOW_PRIORITY ] [ QUICK ] [ IGNORE ]
    FROM table [ . * ] [, ...]
    USING from_expression [, ...]
    [ WHERE boolean_expression ]

# WHERE order_by_expression
{ colname | col_expression } [ ASC | DESC ]

# PARTOFIS from_expression
table [ PARTITION ( partition [, ...] ) ]
[ [ AS ] table_alias ] [ index_hint [...] ]

[ LATERAL ] ( query_statement ) [ AS ] table_alias [ ( col_alias [, ...] ) ]

[ LATERAL ] table_function [ AS ] function_alias [ ( col_alias [, ...] ) ]

( from_expression [, ...] )

from_expression [ INNER ] JOIN from_expression [ join_condition ]

from_expression CROSS JOIN from_expression [ join_condition ]

from_expression STRAIGHT_JOIN from_expression [ ON boolean_expression ]

from_expression { LEFT | RIGHT } [ OUTER ] JOIN from_expression join_condition

from_expression NATURAL [ INNER | { LEFT | RIGHT } [ OUTER ] ] JOIN from_expression

# ONEOFIS join_condition
ON boolean_expression
USING ( colname [, ...] )

# PARTOFIS index_hint
USE { INDEX | KEY }
    [ FOR { JOIN | ORDER BY | GROUP BY } ]
    ( [ index [, ...] ] )

{ FORCE | IGNORE } { INDEX | KEY }
    [ FOR { JOIN | ORDER BY | GROUP BY } ]
    ( index [, ...] )

# WHERE with_query_definition
with_name [ ( colname [, ...] ) ] AS ( query_statement )

# STATEMENT query_statement
SELECT
TABLE
VALUES
