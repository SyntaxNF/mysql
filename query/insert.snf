# https://dev.mysql.com/doc/refman/8.4/en/insert.html

# CASE VALUES
INSERT [ LOW_PRIORITY | DELAYED | HIGH_PRIORITY ] [ IGNORE ]
    [ INTO ] table [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    { VALUES | VALUE } ( { value_expression | DEFAULT } [, ...] ) [, ...]
    [ AS row_alias [ ( col_alias [, ...] ) ] ]
    [ ON DUPLICATE KEY UPDATE column_assignment [, ...] ]

# CASE SET
INSERT [ LOW_PRIORITY | DELAYED | HIGH_PRIORITY ] [ IGNORE ]
    [ INTO ] table [ PARTITION ( partition [, ...] ) ]
    SET column_assignment [, ...]
    [ AS row_alias [ ( col_alias [, ...] ) ] ]
    [ ON DUPLICATE KEY UPDATE column_assignment [, ...] ]

# CASE QUERY
INSERT [ LOW_PRIORITY | HIGH_PRIORITY ] [ IGNORE ]
    [ INTO ] table [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    query_statement
    [ ON DUPLICATE KEY UPDATE column_assignment [, ...] ]

# WHERE column_assignment
colname = { DEFAULT | value_expression | [ row_alias . ] colname | [ table . ] colname | [ row_alias . ] col_alias }

# STATEMENT query_statement
SELECT
TABLE
VALUES
