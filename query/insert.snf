# https://dev.mysql.com/doc/refman/8.4/en/insert.html

# CASE VALUES
INSERT [ LOW_PRIORITY | DELAYED | HIGH_PRIORITY ] [ IGNORE ]
    [ INTO ] table [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    { VALUES | VALUE } ( value [, ...] ) [, ...]
    [ AS row_alias [ ( col_alias [, ...] ) ] ]
    [ ON DUPLICATE KEY UPDATE assignment [, ...] ]

# CASE SET
INSERT [ LOW_PRIORITY | DELAYED | HIGH_PRIORITY ] [ IGNORE ]
    [ INTO ] table [ PARTITION ( partition [, ...] ) ]
    SET assignment [, ...]
    [ AS row_alias [ ( col_alias [, ...] ) ] ]
    [ ON DUPLICATE KEY UPDATE assignment [, ...] ]

# CASE QUERY
INSERT [ LOW_PRIORITY | HIGH_PRIORITY ] [ IGNORE ]
    [ INTO ] table [ PARTITION ( partition [, ...] ) ]
    [ ( colname [, ...] ) ]
    query_expression
    [ ON DUPLICATE KEY UPDATE assignment [, ...] ]

# WHERE value
{ expression | DEFAULT }

# WHERE assignment
colname = { value | [ row_alias . ] colname | [ table . ] colname | [ row_alias . ] col_alias }

# STATEMENT query_expression
SELECT
TABLE
VALUES
