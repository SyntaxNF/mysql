# https://dev.mysql.com/doc/refman/8.4/en/parenthesized-query-expressions.html

# CASE PARENTHESIZED
( query_statement [ order_by_clause ] [ limit_clause ] )
    [ order_by_clause ]
    [ limit_clause ]
    [ into_clause ]

# CASE SET_OPERATION
query_block_statement [ set_operation query_block_statement ] [...]
    [ order_by_clause ]
    [ limit_clause ]
    [ into_clause ]

# WHERE order_by_clause
ORDER BY order_by_expression [, ...]

# WHERE order_by_expression
{ colname | col_expression | position } [ ASC | DESC ]

# WHERE limit_clause
LIMIT { [ offset , ] limit | limit OFFSET offset }

# WHERE into_clause
INTO { OUTFILE 'file' | DUMPFILE 'file' | variable [, ...] }

# WHERE set_operation
{ UNION | INTERSECT | EXCEPT } [ ALL | DISTINCT ]

# STATEMENT query_block_statement, query_statement
SELECT
TABLE
VALUES
