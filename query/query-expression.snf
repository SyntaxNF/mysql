# https://dev.mysql.com/doc/refman/8.4/en/parenthesized-query-expressions.html

# CASE PARENTHESIZED
( query_statement [ order_by_clause ] [ limit_clause ] )
    [ order_by_clause ]
    [ limit_clause ]
    [ into_clause ]

# CASE SET_OPERATION
query_term_statement set_operation_clause [...]
    [ order_by_clause ]
    [ limit_clause ]
    [ into_clause ]

# WHERE query_term_statement
{ query_statement | ( query_statement ) }

# WHERE set_operation_clause
{ UNION | INTERSECT | EXCEPT } [ ALL | DISTINCT ] query_term_statement

# WHERE order_by_clause
ORDER BY order_by_expression [, ...]

# WHERE order_by_expression
{ colname | col_expression | position } [ ASC | DESC ]

# WHERE limit_clause
LIMIT { [ offset , ] limit | limit OFFSET offset }

# PARTOFIS into_clause
INTO OUTFILE 'file'
    [ CHARACTER SET charset ]
    export_options

INTO DUMPFILE 'file'

INTO variable [, ...]

# WHERE export_options
[ { FIELDS | COLUMNS }
    [ TERMINATED BY 'string' ]
    [ [ OPTIONALLY ] ENCLOSED BY 'character' ]
    [ ESCAPED BY 'character' ] ]
[ LINES [ STARTING BY 'string' ] [ TERMINATED BY 'string' ] ]

# STATEMENT query_statement
SELECT
TABLE
VALUES
