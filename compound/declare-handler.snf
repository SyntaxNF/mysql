# https://dev.mysql.com/doc/refman/8.4/en/declare-handler.html

DECLARE { CONTINUE | EXIT } HANDLER
    FOR condition_value [, ...]
    stored_program_statement

# ONEOFIS condition_value
SQLSTATE [ VALUE ] 'sqlstate'
SQLWARNING
NOT FOUND
SQLEXCEPTION
condition
number

# STATEMENT stored_program_statement
sql_statement
compound_statement
