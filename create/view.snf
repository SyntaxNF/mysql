# https://dev.mysql.com/doc/refman/8.4/en/create-view.html

CREATE [ OR REPLACE ]
    [ ALGORITHM = { UNDEFINED | MERGE | TEMPTABLE } ]
    [ DEFINER = user ]
    [ SQL SECURITY { DEFINER | INVOKER } ]
    VIEW name [ ( colname [, ...] ) ]
    [ WITH [ CASCADED | LOCAL ] CHECK OPTION ]
    AS select_statement

# STATEMENT select_statement
SELECT
