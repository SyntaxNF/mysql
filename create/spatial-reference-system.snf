# https://dev.mysql.com/doc/refman/8.4/en/create-spatial-reference-system.html

# CASE REPLACE
CREATE OR REPLACE SPATIAL REFERENCE SYSTEM srid
    NAME 'srs_name'
    DEFINITION 'definition'
    [ ORGANIZATION 'organization_name' IDENTIFIED BY organization_id ]
    [ DESCRIPTION 'description' ]

# CASE NORMAL
CREATE SPATIAL REFERENCE SYSTEM [ IF NOT EXISTS ] srid
    NAME 'srs_name'
    DEFINITION 'definition'
    [ ORGANIZATION 'organization_name' IDENTIFIED BY organization_id ]
    [ DESCRIPTION 'description' ]
