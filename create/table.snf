# https://dev.mysql.com/doc/refman/8.4/en/create-table.html

# CASE NORMAL
CREATE [ TEMPORARY ] TABLE [ IF NOT EXISTS ] name (
    create_definition [, ...]
)
    table_options
    [ partition_options ]

# CASE QUERY
CREATE [ TEMPORARY ] TABLE [ IF NOT EXISTS ] name
    [ ( create_definition [, ...] ) ]
    table_options
    [ partition_options ]
    [ IGNORE | REPLACE ] [ AS ] query_statement

# CASE LIKE
CREATE [ TEMPORARY ] TABLE [ IF NOT EXISTS ] name
    { LIKE like_table | ( LIKE like_table ) }

# ONEOFIS create_definition
colname column_definition
{ INDEX | KEY } [ index ] [ USING { BTREE | HASH } ] ( index_column_expression [, ...] ) index_options
{ FULLTEXT | SPATIAL } [ INDEX | KEY ] [ index ] ( index_column_expression [, ...] ) index_options
[ CONSTRAINT [ constraint ] ] PRIMARY KEY [ USING { BTREE | HASH } ] ( index_column_expression [, ...] ) index_options
[ CONSTRAINT [ constraint ] ] UNIQUE [ INDEX | KEY ] [ index ] [ USING { BTREE | HASH } ] ( index_column_expression [, ...] ) index_options
[ CONSTRAINT [ constraint ] ] FOREIGN KEY [ index ] ( colname [, ...] ) references
check_constraint_definition

# PARTOFIS column_definition
type [ NOT NULL | NULL ] [ DEFAULT { value | ( value_expression ) } ]
[ VISIBLE | INVISIBLE ] [ AUTO_INCREMENT ] [ UNIQUE [ KEY ] ] [ [ PRIMARY ] KEY ]
[ COMMENT 'comment' ] [ COLLATE collate ]
[ COLUMN_FORMAT { FIXED | DYNAMIC | DEFAULT } ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ] [ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]
[ STORAGE { DISK | MEMORY } ] [ references ] [ check_constraint_definition ]

type [ COLLATE collate ] [ GENERATED ALWAYS ] AS ( col_expression )
[ VIRTUAL | STORED ] [ NOT NULL | NULL ] [ VISIBLE | INVISIBLE ]
[ UNIQUE [ KEY ] ] [ [ PRIMARY ] KEY ] [ COMMENT 'comment' ]
[ references ] [ check_constraint_definition ]

# WHERE index_column_expression
{ colname [ ( length ) ] | ( col_expression ) } [ ASC | DESC ]

# WHERE index_options
[ KEY_BLOCK_SIZE [=] value ]
[ WITH PARSER parser ]
[ COMMENT 'comment' ]
[ VISIBLE | INVISIBLE ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ]
[ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]

# WHERE check_constraint_definition
[ CONSTRAINT [ constraint ] ] CHECK ( boolean_expression ) [ [ NOT ] ENFORCED ]

# WHERE references
REFERENCES table ( colname [, ...] )
    [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
    [ ON DELETE on_delete_action ]
    [ ON UPDATE on_update_action ]

# WHERE on_delete_action, on_update_action
{ RESTRICT | CASCADE | SET NULL | NO ACTION | SET DEFAULT }

# WHERE table_options
[ AUTOEXTEND_SIZE [=] value ]
[ AUTO_INCREMENT [=] value ]
[ AVG_ROW_LENGTH [=] value ]
[ [ DEFAULT ] CHARACTER SET [=] charset ]
[ CHECKSUM [=] { 0 | 1 } ]
[ [ DEFAULT ] COLLATE [=] collate ]
[ COMMENT [=] 'comment' ]
[ COMPRESSION [=] { 'ZLIB' | 'LZ4' | 'NONE' } ]
[ CONNECTION [=] 'connection' ]
[ DATA DIRECTORY [=] 'directory' ]
[ INDEX DIRECTORY [=] 'directory' ]
[ DELAY_KEY_WRITE [=] { 0 | 1 } ]
[ ENCRYPTION [=] { 'Y' | 'N' } ]
[ ENGINE [=] engine ]
[ ENGINE_ATTRIBUTE [=] 'engine_attribute' ]
[ INSERT_METHOD [=] { NO | FIRST | LAST } ]
[ KEY_BLOCK_SIZE [=] value ]
[ MAX_ROWS [=] value ]
[ MIN_ROWS [=] value ]
[ PACK_KEYS [=] { 0 | 1 | DEFAULT } ]
[ PASSWORD [=] 'password' ]
[ ROW_FORMAT [=] { DEFAULT | DYNAMIC | FIXED | COMPRESSED | REDUNDANT | COMPACT } ]
[ START TRANSACTION ]
[ SECONDARY_ENGINE_ATTRIBUTE [=] 'secondary_engine_attribute' ]
[ STATS_AUTO_RECALC [=] { DEFAULT | 0 | 1 } ]
[ STATS_PERSISTENT [=] { DEFAULT | 0 | 1 } ]
[ STATS_SAMPLE_PAGES [=] value ]
[ tablespace_option ]
[ UNION [=] ( table [, ...] ) ]

# ONEOFIS tablespace_option
TABLESPACE tablespace [ STORAGE DISK ]
[ TABLESPACE tablespace ] STORAGE MEMORY

# WHERE partition_options
PARTITION BY partition_method
    [ PARTITIONS number ]
    [ SUBPARTITION BY subpartition_method [ SUBPARTITIONS number ] ]
    [ ( partition_definition [, ...] ) ]

# ONEOFIS partition_method
[ LINEAR ] HASH ( col_expression )
[ LINEAR ] KEY [ ALGORITHM = { 1 | 2 } ] ( colname [, ...] )
RANGE { ( col_expression ) | COLUMNS ( colname [, ...] ) }
LIST { ( col_expression ) | COLUMNS ( colname [, ...] ) }

# ONEOFIS subpartition_method
[ LINEAR ] HASH ( col_expression )
[ LINEAR ] KEY [ ALGORITHM = { 1 | 2 } ] ( colname [, ...] )

# WHERE partition_definition
PARTITION partition
    [ VALUES { LESS THAN { ( value [, ...] ) | MAXVALUE } | IN ( value [, ...] ) } ]
    [ [ STORAGE ] ENGINE [=] engine ]
    [ COMMENT [=] 'comment' ]
    [ DATA DIRECTORY [=] 'directory' ]
    [ INDEX DIRECTORY [=] 'directory' ]
    [ MAX_ROWS [=] value ] [ MIN_ROWS [=] value ]
    [ TABLESPACE [=] tablespace ]
    [ ( subpartition_definition [, ...] ) ]

# WHERE subpartition_definition
SUBPARTITION subpartition
    [ [ STORAGE ] ENGINE [=] engine ]
    [ COMMENT [=] 'comment' ]
    [ DATA DIRECTORY [=] 'directory' ]
    [ INDEX DIRECTORY [=] 'directory' ]
    [ MAX_ROWS [=] value ] [ MIN_ROWS [=] value ]
    [ TABLESPACE [=] tablespace ]

# STATEMENT query_statement
SELECT
TABLE
VALUES
