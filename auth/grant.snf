# https://dev.mysql.com/doc/refman/8.4/en/grant.html

# CASE PRIVILEGES
GRANT privilege_definition [, ...]
    ON [ object_type ] privilege_level
    TO account_or_role [, ...]
    [ WITH GRANT OPTION ]
    [ AS account [ WITH ROLE role_context ] ]

# CASE PROXY
GRANT PROXY ON account_or_role
    TO account_or_role [, ...]
    [ WITH GRANT OPTION ]

# CASE ROLES
GRANT role [, ...]
    TO account_or_role [, ...]
    [ WITH ADMIN OPTION ]

# PARTOFIS privilege_definition
{ INSERT | REFERENCES | SELECT | UPDATE } [ ( colname [, ...] ) ]

static_privilege

dynamic_privilege

# ONEOFIS static_privilege
ALL [ PRIVILEGES ]
ALTER
ALTER ROUTINE
CREATE
CREATE ROLE
CREATE ROUTINE
CREATE TABLESPACE
CREATE TEMPORARY TABLES
CREATE USER
CREATE VIEW
DELETE
DROP
DROP ROLE
EVENT
EXECUTE
FILE
FLUSH_PRIVILEGES
GRANT OPTION
INDEX
LOCK TABLES
OPTIMIZE_LOCAL_TABLE
PROCESS
RELOAD
REPLICATION CLIENT
REPLICATION SLAVE
SHOW DATABASES
SHOW VIEW
SHUTDOWN
SUPER
TRIGGER
USAGE

# WHERE object_type
{ TABLE | FUNCTION | PROCEDURE }

# ONEOFIS privilege_level
*
* . *
database . *
database . table
table
database . routine

# ONEOFIS role_context
DEFAULT
NONE
ALL
ALL EXCEPT role [, ...]
role [, ...]
