# https://dev.mysql.com/doc/refman/8.4/en/flush.html

# CASE OPTIONS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] flush_option [, ...]

# CASE TABLES
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] { TABLE | TABLES }

# CASE NAMED_TABLES
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ]
    { TABLE | TABLES } table [, ...]

# CASE TABLES_READ_LOCK
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ]
    { TABLE | TABLES } WITH READ LOCK

# CASE NAMED_TABLES_READ_LOCK
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ]
    { TABLE | TABLES } table [, ...]
    WITH READ LOCK

# CASE TABLES_EXPORT
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ]
    { TABLE | TABLES } table [, ...]
    FOR EXPORT

# ONEOFIS flush_option
BINARY LOGS
ENGINE LOGS
ERROR LOGS
GENERAL LOGS
LOGS
PRIVILEGES
OPTIMIZER_COSTS
RELAY LOGS [ FOR CHANNEL 'channel' ]
SLOW LOGS
STATUS
USER_RESOURCES
