# https://dev.mysql.com/doc/refman/8.4/en/flush.html

# CASE BINARY_LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] BINARY LOGS

# CASE ENGINE_LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] ENGINE LOGS

# CASE ERROR_LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] ERROR LOGS

# CASE GENERAL_LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] GENERAL LOGS

# CASE LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] LOGS

# CASE PRIVILEGES
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] PRIVILEGES

# CASE OPTIMIZER_COSTS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] OPTIMIZER_COSTS

# CASE RELAY_LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] RELAY LOGS
    [ FOR CHANNEL 'channel' ]

# CASE SLOW_LOGS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] SLOW LOGS

# CASE STATUS
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] STATUS

# CASE USER_RESOURCES
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] USER_RESOURCES

# CASE TABLES
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] { TABLE | TABLES }

# CASE NAMED_TABLES
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] { TABLE | TABLES } table [, ...]

# CASE TABLES_READ_LOCK
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ] { TABLE | TABLES } WITH READ LOCK

# CASE NAMED_TABLES_READ_LOCK
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ]
    { TABLE | TABLES } table [, ...] WITH READ LOCK

# CASE TABLES_EXPORT
FLUSH [ NO_WRITE_TO_BINLOG | LOCAL ]
    { TABLE | TABLES } table [, ...] FOR EXPORT
