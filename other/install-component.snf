# https://dev.mysql.com/doc/refman/8.4/en/install-component.html

INSTALL COMPONENT component_value [, ...]
    [ SET component_variable_assignment [, ...] ]

# WHERE component_variable
{ GLOBAL | @@GLOBAL. | PERSIST | @@PERSIST. } [ component_prefix . ] system_variable

# WHERE component_variable_assignment
component_variable = value_expression

# WHERE component_value
'component'
