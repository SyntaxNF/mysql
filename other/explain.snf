# https://dev.mysql.com/doc/refman/8.4/en/explain.html

# CASE QUERY
{ EXPLAIN | DESCRIBE | DESC }
    [ FORMAT = { TRADITIONAL | JSON | TREE } ]
    [ INTO @user_variable ]
    [ FOR { SCHEMA | DATABASE } database ]
    explainable_statement

# CASE ANALYZE
{ EXPLAIN | DESCRIBE | DESC } ANALYZE [ FORMAT = TREE ]
    [ FOR { SCHEMA | DATABASE } database ]
    explainable_statement

# CASE CONNECTION
{ EXPLAIN | DESCRIBE | DESC }
    [ FORMAT = { TRADITIONAL | JSON | TREE } ]
    FOR CONNECTION connection_id

# CASE TABLE
{ EXPLAIN | DESCRIBE | DESC } table [ colname | 'pattern' ]

# STATEMENT explainable_statement
SELECT
TABLE
DELETE
INSERT
REPLACE
UPDATE
