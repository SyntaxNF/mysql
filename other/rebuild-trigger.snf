# https://dev.mysql.com/doc/refman/8.4/en/create-trigger.html

# CASE OPTIONS
CREATE [ DEFINER = user ] TRIGGER name
    { BEFORE | AFTER }
    { INSERT | UPDATE | DELETE }
    ON table FOR EACH ROW
    [ { FOLLOWS | PRECEDES } other_trigger ]
    trigger_statement

# STATEMENT trigger_statement
sql_statement
compound_statement
