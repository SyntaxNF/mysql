# https://dev.mysql.com/doc/refman/8.4/en/set-variable.html

SET variable_assignment [, ...]

# ONEOFIS variable_assignment
system_variable_assignment
user_variable_assignment
local_or_parameter_variable_assignment

# WHERE system_variable_assignment
system_variable_target { = | := } { value_expression | DEFAULT }

# ONEOFIS system_variable_target
[ GLOBAL | PERSIST | PERSIST_ONLY | SESSION | LOCAL ] system_variable
@@ [ { GLOBAL | PERSIST | PERSIST_ONLY | SESSION | LOCAL } . ] system_variable

# WHERE user_variable_assignment
@user_variable { = | := } value_expression

# WHERE local_or_parameter_variable_assignment
{ local_variable | parameter } { = | := } value_expression
