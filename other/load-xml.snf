# https://dev.mysql.com/doc/refman/8.4/en/load-xml.html

LOAD XML [ LOW_PRIORITY | CONCURRENT ] [ LOCAL ]
    INFILE 'file' [ REPLACE | IGNORE ]
    INTO TABLE table
    [ CHARACTER SET charset ]
    [ ROWS IDENTIFIED BY 'tag' ]
    [ IGNORE number { LINES | ROWS } ]
    [ ( field_or_variable [, ...] ) ]
    [ SET colname = { expression | DEFAULT } [, ...] ]
