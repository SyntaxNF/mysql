# https://dev.mysql.com/doc/refman/8.4/en/alter-view.html

ALTER [ ALGORITHM = { UNDEFINED | MERGE | TEMPTABLE } ]
    [ DEFINER = user ]
    [ SQL SECURITY { DEFINER | INVOKER } ]
    VIEW view [ ( colname [, ...] ) ]
    AS select_statement
    [ WITH [ CASCADED | LOCAL ] CHECK OPTION ]

# STATEMENT select_statement
SELECT
