# https://dev.mysql.com/doc/refman/8.4/en/alter-user.html

# CASE CURRENT_PASSWORD
ALTER USER [ IF EXISTS ] USER ( ) IDENTIFIED BY auth_string
    [ REPLACE current_auth_string ]
    [ RETAIN CURRENT PASSWORD | DISCARD OLD PASSWORD ]

# CASE ACCOUNTS
ALTER USER [ IF EXISTS ]
    account [ auth_option ] [, ...]
    [ REQUIRE { NONE | tls_option [ [ AND ] tls_option ] ... } ]
    [ WITH resource_option [ resource_option ] ... ]
    [ password_option | lock_option ] [...]
    [ COMMENT string | ATTRIBUTE json ]

# CASE REGISTRATION
ALTER USER [ IF EXISTS ] account
    [ MODIFY factor ] FINISH REGISTRATION SET CHALLENGE_RESPONSE AS auth_string

# WHERE factor
{ 2 | 3 } FACTOR

# ONEOFIS auth_option
IDENTIFIED BY auth_string [ REPLACE current_auth_string ] [ RETAIN CURRENT PASSWORD | DISCARD OLD PASSWORD ]
IDENTIFIED BY RANDOM PASSWORD [ RETAIN CURRENT PASSWORD | DISCARD OLD PASSWORD ]
IDENTIFIED WITH auth_plugin [ BY auth_string | BY RANDOM PASSWORD | AS auth_string ]
ADD factor IDENTIFIED WITH auth_plugin [ BY auth_string | BY RANDOM PASSWORD ]
MODIFY factor IDENTIFIED WITH auth_plugin [ BY auth_string | BY RANDOM PASSWORD ]
DROP factor

# ONEOFIS tls_option
SSL
X509
CIPHER string
ISSUER string
SUBJECT string

# ONEOFIS resource_option
MAX_QUERIES_PER_HOUR count
MAX_UPDATES_PER_HOUR count
MAX_CONNECTIONS_PER_HOUR count
MAX_USER_CONNECTIONS count

# ONEOFIS password_option
PASSWORD EXPIRE [ DEFAULT | NEVER | INTERVAL number DAY ]
PASSWORD HISTORY { DEFAULT | number }
PASSWORD REUSE INTERVAL { DEFAULT | number DAY }
PASSWORD REQUIRE CURRENT [ DEFAULT | OPTIONAL ]
FAILED_LOGIN_ATTEMPTS number
PASSWORD_LOCK_TIME { number | UNBOUNDED }

# ONEOFIS lock_option
ACCOUNT LOCK
ACCOUNT UNLOCK
